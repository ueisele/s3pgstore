  "description": "s3pgstore observability — starter dashboard. Phase 16 of the v2.0 plan calls for ~10 section rows and ~30 panels covering write/read volumes, S3 ops, sequencer state, iter pipeline saturation, and catalog locking. This file ships the foundation: section rows + panels for the two metrics wired in v2.0 (s3pgstore.method.duration and s3pgstore.method.calls). Operators should expand panels as additional metrics land per CLAUDE.md § Metrics ↔ dashboard sync.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "panels": [],
      "title": "Library methods — selected bucket/prefix",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_metrics}"
      },
      "description": "Per-method duration percentiles. Labels filtered to the selected bucket/prefix/cluster/stage. Min step 1m matches workload granularity (per s3store dashboard convention).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "",
            "drawStyle": "line",
            "lineWidth": 1
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 101,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_metrics}"
          },
          "expr": "histogram_quantile(0.50, sum by (le, method) (rate(s3pgstore_method_duration_seconds_bucket{cluster=~\"$cluster\", stage=~\"$stage\", k8s_namespace_name=~\"$namespace\", s3pgstore_bucket=~\"$bucket\", s3pgstore_prefix=~\"$prefix\"}[$__rate_interval])))",
          "legendFormat": "P50 {{method}}",
          "interval": "1m",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_metrics}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(s3pgstore_method_duration_seconds_bucket{cluster=~\"$cluster\", stage=~\"$stage\", k8s_namespace_name=~\"$namespace\", s3pgstore_bucket=~\"$bucket\", s3pgstore_prefix=~\"$prefix\"}[$__rate_interval])))",
          "legendFormat": "P95 {{method}}",
          "interval": "1m",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_metrics}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, method) (rate(s3pgstore_method_duration_seconds_bucket{cluster=~\"$cluster\", stage=~\"$stage\", k8s_namespace_name=~\"$namespace\", s3pgstore_bucket=~\"$bucket\", s3pgstore_prefix=~\"$prefix\"}[$__rate_interval])))",
          "legendFormat": "P99 {{method}}",
          "interval": "1m",
          "refId": "C"
        }
      ],
      "title": "Method duration (P50/P95/P99)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource_metrics}"
      },
      "description": "Method call rate by outcome. A non-zero rate of outcome=\"error\" indicates failures the application should investigate; outcome=\"canceled\" usually reflects caller-side ctx cancellation rather than library failure.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 102,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource_metrics}"
          },
          "expr": "sum by (method, outcome) (rate(s3pgstore_method_calls_total{cluster=~\"$cluster\", stage=~\"$stage\", k8s_namespace_name=~\"$namespace\", s3pgstore_bucket=~\"$bucket\", s3pgstore_prefix=~\"$prefix\"}[$__rate_interval]))",
          "legendFormat": "{{method}} / {{outcome}}",
          "interval": "1m",
          "refId": "A"
        }
      ],
      "title": "Method call rate by outcome",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["s3pgstore"],
